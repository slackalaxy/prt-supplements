#!/bin/bash
#
# prtskim: extensive cleaning and refreshing of ports
#
# Petar Petrov, slackalaxy at gmail dot com
#

# Is input empty?
if [ "$1" = "" ]; then
    echo "Input is empty. Usage: $(basename $0) [port...]"
    exit 1
fi

# no options with the tool
for t in "$@"; do
  if [ "${t:0:1}" = "-" ]; then
    echo -e "Invalid input $t. Usage: $(basename $0) [port...]"
    exit 1
  fi
done

for i in "$@"; do
  if [[ -d $i ]]; then
    if [ -f "$i/Pkgfile" ]; then
      # The parentheses run these commands in a "subshell", a separate
      # copy of the shell. The "cd" only happens inside it, so after the
      # closing bracket we are automatically *back* in the original dir,
      # even if $i was a path like crux-ports/custom/foo.
      #
      # Without &&, every command runs no matter whether the previous
      # one succeeded. || is the opposite: means "run the next command
      # only if the previous one failed" (echo after the parentheses).
      (
        prtwash "$i" &&
        cd "$i" &&
        rm -f .md5sum &&
        pkgmk -uf &&
        pkgmk -us
      ) || echo "===== $i: a step failed, $i was not signed"
    else
      echo "===== $i is not a port, ignoring"
    fi
  else
    echo "===== $i is not a directory, ignoring"
  fi
done
